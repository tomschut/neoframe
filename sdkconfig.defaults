CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Default (512) is too small for real mobile-browser request headers
# (client hints, cookies, etc.) - both the captive portal and the always-on
# settings page hit "header too long" on phones without this.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# esp_https_ota refuses any transfer with no server verification (no TLS,
# no cert) unless this is set - a second, independent gate from our own
# HTTP-allowed firmware_url validation. Explicit per the user's requirement
# that OTA work over plain HTTP on the LAN.
CONFIG_OTA_ALLOW_HTTP=y
# Power management framework, needed for esp_pm_configure()/automatic light
# sleep used by the "pause" state. Frequency is kept fixed (see light_sleep()
# in main.c) - only the tickless-idle light-sleep behavior is used, not DFS.
# PM_ENABLE does NOT auto-select TICKLESS_IDLE in this IDF version - without
# it, esp_pm_configure(light_sleep_enable=true) returns ESP_ERR_NOT_SUPPORTED
# (confirmed live on hardware).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
